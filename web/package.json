{
  "name": "@vibehub/web",
  "private": true,
  "version": "0.1.0",
  "description": "VibeHub web client — React + Vite, strict monochrome UI.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/normalize-eol.mjs --fix && tsc -b && vite build && node scripts/normalize-eol.mjs --check",
    "preview": "vite preview --host --port 5173",
    "start": "serve -s dist -l ${PORT:-4173}"
  },
  "dependencies": {
    "lottie-web": "^5.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "serve": "^14.2.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
