# Server — see ../docs/BUILD_PLAN.md §3 for the full ports/env-vars table.

PORT=4000
CORS_ORIGIN=http://localhost:5173

# Postgres (npm run db:migrate). For SQLite dev fallback (npm run db:dev) use:
#   DATABASE_URL="file:./dev.db"
DATABASE_PROVIDER=postgresql
DATABASE_URL="postgresql://vibehub:vibehub@localhost:5432/vibehub"

JWT_SECRET=change-me-in-production

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback

# Enables POST /api/v1/auth/dev-login. Never set true in production.
DEV_LOGIN_ENABLED=true

SESSION_IDLE_TIMEOUT_MS=600000

# Avatar storage. Defaults to <cwd>/uploads; on Railway a persistent volume is mounted
# at /app/uploads so the default just works.
# UPLOAD_DIR=/app/uploads

# Web and API on different sites (e.g. two *.up.railway.app domains) → set to "none".
# COOKIE_SAME_SITE=lax
